# Environment configuration for Grocery Visualiser
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Flask / Application
# -----------------------------------------------------------------------------

# Flask environment: development or production
FLASK_ENV=production

# Port the application listens on (default: 5000)
PORT=5000

# Secret key for session management — set a random string for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# -----------------------------------------------------------------------------
# Admin User (first-run auto-creation)
# -----------------------------------------------------------------------------

# If both are set and no admin user exists, an admin account is created on first boot
ADMIN_USERNAME=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Path to SQLite database file (relative or absolute)
DATABASE_PATH=/app/data/groceries.db

# -----------------------------------------------------------------------------
# File Uploads (local storage fallback)
# -----------------------------------------------------------------------------

# Directory for local image uploads (used when R2 is not configured)
UPLOAD_DIR=/app/static/uploads

# -----------------------------------------------------------------------------
# Cloudflare R2 (optional — for image storage)
# -----------------------------------------------------------------------------

# R2 bucket name
R2_BUCKET=

# R2 access key
R2_ACCESS_KEY=

# R2 secret key
R2_SECRET_KEY=

# Cloudflare account ID (used for R2 credentials)
R2_ACCOUNT_ID=

# R2 domain for public URLs (default: <bucket>.r2.dev if not set)
R2_DOMAIN=
