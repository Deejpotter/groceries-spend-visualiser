# Environment configuration for Grocery Visualiser
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Flask / Application
# -----------------------------------------------------------------------------

# Port the application listens on (default: 5000)
PORT=5000

# Secret key for session management — set a random string for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# -----------------------------------------------------------------------------
# Admin User (first-run auto-creation)
# -----------------------------------------------------------------------------

# If both are set and no admin user exists, an admin account is created on first boot
ADMIN_USERNAME=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Path to the SQLite database file. Leave unset for ./data/groceries.db locally;
# docker-compose sets /app/data/groceries.db.
# DATABASE_PATH=
